# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Email product notifications with Resend. Supabase can still handle auth emails.
RESEND_API_KEY=
FROM_EMAIL=
REPLY_TO_EMAIL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_CAREER_SPRINT_PRICE_ID=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAILS=
FREE_PRACTICE_LIMIT=3

# Local/preview visual QA bypass for AI English Phase A routes.
# Ignored in production, and still limited to exact /app/ai-trainer Phase A paths.
NEXT_PUBLIC_ENABLE_AI_ENGLISH_DEMO=false

# First-party analytics works without extra env vars and stores consented
# anonymous funnel events in internal_events. External providers are optional.
# Analytics optional: plausible or posthog
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Paid ads pixels optional. Loaded only after user analytics consent.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
